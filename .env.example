# OushodBox Environment Variables Configuration

# Designated Administrator Account
# Only this email is authorized to access the admin workspace and perform reads/writes.
# Note: Changing this also requires updating the adminEmail() function in firestore.rules
# and running `firebase deploy --only firestore:rules`.
NEXT_PUBLIC_ADMIN_EMAIL=mehj49966@gmail.com

# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=osudhbox.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=osudhbox
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=osudhbox.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=654688835279
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id-here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id-here
