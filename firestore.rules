rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the request is from the authorized administrator
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "mehj49966@gmail.com";
    }

    // Medicines collection rules
    // 1. Anyone can read medicine records from /medicines/{medicineId}
    // 2. Only the authenticated admin account (mehj49966@gmail.com) can create, update, or delete
    match /medicines/{medicineId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny rule: All other collections and documents are protected against unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
