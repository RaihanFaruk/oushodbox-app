rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin email constant — MUST be kept in sync with NEXT_PUBLIC_ADMIN_EMAIL
    function adminEmail() {
      return "mehj49966@gmail.com";
    }

    // Helper function to check if the request is from the authorized administrator
    function isAdmin() {
      return request.auth != null && request.auth.token.email == adminEmail();
    }

    // Medicines collection: strictly private, admin-only read & write
    match /medicines/{medicineId} {
      allow read, create, update, delete: if isAdmin();

      // Price history subcollection: append-only and immutable
      match /priceHistory/{entryId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Default deny rule: All other collections and documents are protected against unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
